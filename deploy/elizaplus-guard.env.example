# /etc/elizaplus-guard.env (example: replace the hostname). No secrets belong in this file.
# The guard listens on loopback only; nginx proxies /api/chat to it.
GUARD_UPSTREAM=http://lmstudio.example.lan:1234/v1/chat/completions
GUARD_MODEL=google/gemma-4-26b-a4b-qat
GUARD_PORT=3100
# Tuning (defaults shown): per-user requests per minute and burst, requests the model serves at once,
# how many may wait, and the longest reply (tokens).
GUARD_RATE_PER_MIN=30
GUARD_BURST=10
GUARD_MAX_CONCURRENT=2
GUARD_MAX_QUEUE=20
GUARD_MAX_TOKENS=300
